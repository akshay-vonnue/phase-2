model Issue {
  id           String        @id @default(cuid())
  title        String
  description  String
  status       ErrorStatus
  priority     IssuePriority
  overdue      BigInt
  // projectId    String
  // project      Project       @relation(fields: [projectId], references: [id])
  resolverId   String
  resolverName String
}

model Project {
  id          String @id @default(cuid())
  title       String
  description String
  // issues      Issue[]
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
  avatar       String
}
