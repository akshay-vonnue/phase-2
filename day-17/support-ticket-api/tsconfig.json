{
    "compilerOptions":{
        "strict": true,
        "module": "esnext",
        "moduleResolution":"bundler",
        "target": "es2023",
        "rootDir": "src",
        "outDir":"dist",
        "esModuleInterop": true,
        "ignoreDeprecations": "6.0",
        "types": ["node","express"]
    },
    "include":[
        "src/**/*",
        "generated/**/*"
    ]
}